# Adjamé-Smart — API (copier en .env et remplir)
PORT=3100
HOST=127.0.0.1
DB_HOST=localhost
DB_PORT=5432
DB_USER=adjame
DB_PASSWORD=
DB_NAME=adjame_smart
# false en production une fois le schéma stable
DB_SYNC=true
JWT_SECRET=
# Premier compte Super Admin (créé au démarrage s'il n'existe pas)
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PASSWORD=
# Origines du back-office autorisées (vide = toutes, développement)
CORS_ORIGIN=
# Stockage Wasabi (facultatif ; sinon dossier uploads/ local)
WAS_ACCESS_KEY=
WAS_SECRET_KEY=
WASABI_REGION=eu-central-1
WASABI_BUCKET=
WASABI_IDENTITY_BUCKET=
# Livraison VITE (API partenaire) : clé créée dans le back-office VITE, page « Partenaires API »
LETO_API_URL=https://api.leto.performx.online
LETO_API_KEY=
# Secret des webhooks (affiché par VITE avec la clé) ; adresse à donner à VITE : https://api.as.performx.online/webhooks/leto
LETO_WEBHOOK_SECRET=
# Encaissement par Adjamé-Smart (boutiques en mode « via Adjamé-Smart ») : alias PI-SPI et nom affichés au client
AS_PISPI_ALIAS=
AS_PISPI_NAME=Adjamé-Smart
